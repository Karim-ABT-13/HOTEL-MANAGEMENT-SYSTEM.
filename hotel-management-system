# ============================================================
# BOOK A ROOM
# ============================================================

def book_a_room():

    console.print(
        Panel(" BOOK A ROOM")
    )

    print()

    guest_number = int(input("Number of Guests: "))

    print()

    if guest_number == 1:

        print()
        print("Available rooms for you: ")

        for room_name, room_info in rooms.items():
            if room_info.get("availability") == "available":
                print("-", room_name, "'", room_info.get("type_room"), "'")

    elif guest_number == 2 or guest_number == 3:

        print()
        print("Available rooms for you: ")

        for room_name, room_info in rooms.items():
            if (
                room_info.get("availability") == "available"
                and (
                    room_info.get("capacity") == 2
                    or room_info.get("capacity") == 3
                )
            ):
                print("-", room_name, "'", room_info.get("type_room"), "'")

    elif guest_number == 3 or guest_number == 4:

        print()
        print("Available rooms for you: ")

        for room_name, room_info in rooms.items():
            if (
                room_info.get("availability") == "available"
                and (
                    room_info.get("capacity") == 3
                    or room_info.get("capacity") == 4
                )
            ):
                print("-", room_name, "'", room_info.get("type_room"), "'")

    else:
        print("Sorry, they are not a room with this capacity of guests;")
        exit()

    main_menu()

    print()

    choose_a_room = input("Choose a Room: ")

    print()

    for room_name, room_info in rooms.items():

        if choose_a_room == room_name:

            print("=" * 25, " ROOM DETAILS ", "=" * 25)
            print()

    for room_name, room_info in rooms.items():

        for feature, value in room_info.items():

            if choose_a_room == room_name:
                print(f"{feature} : {value}")

    print("=" * 67)
    print()

    # Confirm Booking
    confirm_booking = Confirm.ask("Confirm Booking?")

    if confirm_booking == "no":
        main_menu()

    elif True:

        with open("booking.txt", "w") as file:
            print()

            # Progress bar
            with Progress() as progress:

                task = progress.add_task(
                    "Loading...",
                    total=100
                )

                while not progress.finished:
                    progress.update(
                        task,
                        advance=1
                    )

                    time.sleep(0.05)

            print()

            name = Prompt.ask("Costumer Name")
            phone = IntPrompt.ask("Phone Number")
            check_in = IntPrompt.ask("Check-in Date")
            check_out = IntPrompt.ask("Check-out Date")

            nights = check_out - check_in

            price = rooms[choose_a_room]["price"] * nights

            rooms[choose_a_room]["availability"] = "booked"

            # Booking progress bar
            with Progress() as progress:

                task = progress.add_task(
                    "Booking...",
                    total=100
                )

                while not progress.finished:
                    progress.update(
                        task,
                        advance=1
                    )

                    time.sleep(0.03)

            print(
                choose_a_room,
                "Has been booked succesfully!"
            )

            file.write(
                f"{name} | str{phone} | str{check_in} | "
                f"str{check_out} | {choose_a_room} | "
                f"str{nights} | str{price}"
            )

            def booking_summary():

                table = Table(
                    title="BOOKING SUMMARY"
                )

                table.add_column("Name")
                table.add_column("Phone Number")
                table.add_column("Check-in Date")
                table.add_column("Check-out Date")
                table.add_column("Room Number")
                table.add_column("Nights")
                table.add_column("Total Price")

                table.add_row(
                    name,
                    str(phone),
                    str(check_in),
                    str(check_out),
                    str(choose_a_room),
                    str(nights),
                    str(price)
                )

                console.print(table)

            booking_summary()

    print()
    print("=" * 30)

    main_menu()


