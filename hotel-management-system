def cancel_booking():

    console.print(
        Panel(" CANCEL BOOKING")
    )

    with open("booking.txt", "r") as file:

        for line in file:

            data = line.strip().split(" | ")

            name = data[0]
            phone = data[1]
            check_in = data[2]
            check_out = data[3]
            choose_a_room = data[4]
            nights = data[5]
            price = data[6]

            confirm_cancling = Confirm.ask(
                "Confirm Cancelling booking?"
            )

            if confirm_cancling:
                print()

                # Progress bar
                with Progress() as progress:

                    task = progress.add_task(
                        "Cancelling Booking...",
                        total=100
                    )

                    while not progress.finished:

                        progress.update(
                            task,
                            advance=1
                        )

                        time.sleep(0.02)

                rooms[choose_a_room]["availability"] = "available"

                print(
                    choose_a_room,
                    "Turned to available room successfuly!"
                )

                print()

                print("=" * 30)

                room_info = rooms.get(
                    choose_a_room
                )

                if room_info:

                    for feature, value in room_info.items():
                        print(f"{feature} : {value}")

                else:
                    print("Sorry, no room found")

                print("=" * 30)

                main_menu()

    print("=" * 30)


