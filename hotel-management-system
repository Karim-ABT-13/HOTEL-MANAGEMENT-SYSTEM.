# UPDATE BOOKING
# ============================================================

def update_booking():

    console.print(
        Panel(" UPDATE BOOKING")
    )

    print()

    update_booking = Prompt.ask(
        "Update Booking? [y/n] "
    )

    if update_booking == "y":

        print()

        search_room = input(
            "Enetr te name of the room you want to change it: "
        )

        with open("booking.txt", "r") as file:

            for line in file:

                data = line.strip().split(" | ")

                name = data[0]
                phone = data[1]
                check_in = data[2]
                check_out = data[3]

                file.readlines()

                if search_room == name:

                    what_do_you_want = input(
                        "what do you want to change it? "
                    )

                    if what_do_you_want == "name":

                        new_name = input(
                            "Enter the new name: "
                        )

                        data[0] = new_name

                    elif what_do_you_want == "phone":

                        new_phone_number = input(
                            "Enter the new phone number: "
                        )

                        data[1] = new_phone_number

                    elif what_do_you_want == "check-in":

                        new_checkIn_date = input(
                            "Enter the new check-in date: "
                        )

                        data[2] = new_checkIn_date

                    elif what_do_you_want == "check-out":

                        new_checkOut_date = input(
                            "Enter the new check-out date: "
                        )

                        data[3] = new_checkOut_date

                    else:
                        print(
                            "Sorry no informations found!"
                        )

        print()
        print("=" * 30)

        main_menu()

        with open("booking.txt", "w") as file:
            file.write("booking.txt")

        print(
            name,
            phone,
            check_in,
            check_out
        )

    elif update_booking == "n":

        print()
        print("=" * 30)

        main_menu()


